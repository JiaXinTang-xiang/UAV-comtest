# Local Git metadata of vendored dependencies; preserve it for PX4 builds.
**/.git

# Build/install outputs stay on disk, but are not source code.
**/build/
**/build_*/
**/install/
**/log/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
*.ulg

# Live logs and failed training attempts; retain curated successful evidence.
/logs/*
!/logs/flight/
/logs/flight/*
# 左路线成功
!/logs/flight/region_20261022_112416.json
!/logs/flight/px4_hover_20261022_112417_032636.json
!/logs/flight/px4_hover_20261022_112417_032636.csv
# 右路线成功
!/logs/flight/region_20261022_112212.json
!/logs/flight/px4_hover_20261022_112212_568801.json
!/logs/flight/px4_hover_20261022_112212_568801.csv

# Downloads and accidental empty shell output files.
/micro-xrce-dds-agent.tar.gz
/ABORTING
/LANDING
