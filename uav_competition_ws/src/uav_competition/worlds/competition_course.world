    <model name="wall_lower_right_leg"><static>true</static><pose>8 7 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.15 2 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.15 2 3</size></box></geometry><material><ambient>.55 .55 .58 1</ambient><diffuse>.55 .55 .58 1</diffuse></material></visual></link></model>
