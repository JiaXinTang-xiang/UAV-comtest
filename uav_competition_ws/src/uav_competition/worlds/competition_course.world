<?xml version="1.0"?>
<sdf version="1.6">
  <world name="competition_course">
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.72 0.75 0.78 1</background><shadows>true</shadows></scene>
    <!-- View from +y so map y=0 is at the top and y=10 is at the bottom. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>5 24 14 0 0.65 -1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <!-- Visual texture for image optical flow. No collision geometry. -->
    <include><uri>model://training_surface</uri><pose>5 5 0.025 0 0 0</pose></include>
    <!-- Load Iris with the world. Runtime factory insertion can hang in
         Gazebo Classic after the ROS factory plugin has been interrupted. -->
    <include>
      <uri>model://iris</uri>
      <name>iris</name>
      <pose>5 9 0.83 0 0 0</pose>
    </include>
    <model name="course_floor"><static>true</static><pose>5 5 -0.03 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 10 .05</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 10 .05</size></box></geometry><material><ambient>.78 .78 .74 1</ambient><diffuse>.78 .78 .74 1</diffuse></material></visual></link></model>
    <!-- The +y overview mirrors screen x, so world x = 10 - map x. -->
    <model name="region_5_floor"><static>true</static><pose>5 1 0.006 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>9.7 1.9 0.012</size></box></geometry><material><ambient>0.96 0.92 0.72 1</ambient><diffuse>0.96 0.92 0.72 1</diffuse></material></visual></link></model>
    <model name="region_4_floor"><static>true</static><pose>5 3 0.006 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>9.7 1.9 0.012</size></box></geometry><material><ambient>0.82 0.92 0.92 1</ambient><diffuse>0.82 0.92 0.92 1</diffuse></material></visual></link></model>
    <model name="region_3_floor"><static>true</static><pose>5 5 0.006 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>9.7 1.9 0.012</size></box></geometry><material><ambient>0.82 0.88 0.94 1</ambient><diffuse>0.82 0.88 0.94 1</diffuse></material></visual></link></model>
    <model name="region_2_floor"><static>true</static><pose>5 7 0.006 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>9.7 1.9 0.012</size></box></geometry><material><ambient>0.84 0.84 0.92 1</ambient><diffuse>0.84 0.84 0.92 1</diffuse></material></visual></link></model>
    <model name="region_1_floor"><static>true</static><pose>5 9 0.006 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>9.7 1.9 0.012</size></box></geometry><material><ambient>0.96 0.90 0.76 1</ambient><diffuse>0.96 0.90 0.76 1</diffuse></material></visual></link></model>
    <model name="boundary_top"><static>true</static><pose>5 0.075 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.15 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.15 3</size></box></geometry><material><ambient>.18 .18 .20 1</ambient><diffuse>.18 .18 .20 1</diffuse></material></visual></link></model>
    <model name="boundary_bottom"><static>true</static><pose>5 9.925 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.15 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.15 3</size></box></geometry><material><ambient>.18 .18 .20 1</ambient><diffuse>.18 .18 .20 1</diffuse></material></visual></link></model>
    <model name="boundary_left"><static>true</static><pose>0.075 5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.15 10 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.15 10 3</size></box></geometry><material><ambient>.18 .18 .20 1</ambient><diffuse>.18 .18 .20 1</diffuse></material></visual></link></model>
    <model name="boundary_right"><static>true</static><pose>9.925 5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.15 10 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.15 10 3</size></box></geometry><material><ambient>.18 .18 .20 1</ambient><diffuse>.18 .18 .20 1</diffuse></material></visual></link></model>
    <model name="wall_top_u_horizontal"><static>true</static><pose>7 2 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 0.15 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 0.15 3</size></box></geometry><material><ambient>.55 .55 .58 1</ambient><diffuse>.55 .55 .58 1</diffuse></material></visual></link></model>
