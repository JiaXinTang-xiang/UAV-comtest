<?xml version="1.0"?>
<sdf version="1.6">
<world name="competition_course">
  <physics name="default_physics" type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
  </physics>
  <scene>
    <ambient>0.4 0.4 0.4 1</ambient>
    <background>0.7 0.7 0.7 1</background>
  </scene>

  <!-- ========== 功能区域 ========== -->
  <!-- 起飞区 2m×2m 绿色 区域1 中心(5,9) -->
  <model name="takeoff_zone">
    <static>true</static>
    <pose>5 9 0.01 0 0 0</pose>
    <link name="link">
      <visual name="vis">
        <geometry><box><size>2 2 0.02</size></box></geometry>
        <material>
          <ambient>0 0.8 0 1</ambient>
          <diffuse>0 0.8 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 降落区 2m×2m 红色 区域5 中心(3,1) -->
  <model name="landing_zone">
    <static>true</static>
    <pose>3 1 0.01 0 0 0</pose>
    <link name="link">
      <visual name="vis">
        <geometry><box><size>2 2 0.02</size></box></geometry>
        <material>
          <ambient>0.8 0 0 1</ambient>
          <diffuse>0.8 0 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 选手飞行站立区 4m×2m 场外底部 -->
  <model name="operator_zone">
    <static>true</static>
    <pose>5 11 0.01 0 0 0</pose>
    <link name="link">
      <visual name="vis">
        <geometry><box><size>4 2 0.02</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.7 0.5</ambient>
          <diffuse>0.7 0.7 0.7 0.5</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ========== 外围边界墙 深灰色 ========== -->
  <model name="wall_bound_top">
    <static>true</static>
    <pose>5 0.1 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>10 0.2 2</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_bound_bottom">
    <static>true</static>
    <pose>5 9.9 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>10 0.2 2</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_bound_left">
    <static>true</static>
    <pose>0.1 5 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.2 10 2</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_bound_right">
    <static>true</static>
    <pose>9.9 5 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.2 10 2</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ========== 内部隔墙 浅灰色 严格对齐图纸 ========== -->
  <!-- 顶部U型墙-左竖 -->
  <model name="wall_u_left">
    <static>true</static>
    <pose>2.1 2 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.2 2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 顶部U型墙-右竖 -->
  <model name="wall_u_right">
    <static>true</static>
    <pose>3.9 2 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.2 2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 顶部U型墙-底横 -->
  <model name="wall_u_bottom">
    <static>true</static>
    <pose>3 3 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>2 0.2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>2 0.2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 左侧L型凸墙-横段 y=4 x1~4 -->
  <model name="wall_convex_h">
    <static>true</static>
    <pose>2.5 4 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>3 0.2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>3 0.2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 左侧L型凸墙-竖段 x=4 y4~6 -->
  <model name="wall_convex_v">
    <static>true</static>
    <pose>4 5 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.2 2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 右侧横墙 y=4 x5~9 -->
  <model name="wall_right_h">
    <static>true</static>
    <pose>7 4 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>4 0.2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>4 0.2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 左侧方块障碍 x0~2 y6~8 -->
  <model name="wall_block_left">
    <static>true</static>
    <pose>1 7 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>2 2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>2 2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 右侧方块障碍 x8~10 y6~8 -->
  <model name="wall_block_right">
    <static>true</static>
    <pose>9 7 1 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>2 2 2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>2 2 2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
  <!-- Iris无人机模型，直接嵌入，不需要外部iris.sdf -->
 <!-- Iris 四轴无人机 -->
<model name="iris">
  <pose>0 0 0.5 0 0 0</pose>
  <static>false</static>
  <link name="base_link">
    <inertial>
      <mass>1.0</mass>
      <inertia>
        <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.02</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
    <collision name="body_collision">
      <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
    </collision>
    <visual name="body_visual">
      <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
    </visual>
  </link>

  <!-- rotor0 -->
  <joint name="joint0" type="revolute">
    <parent>base_link</parent>
    <child>rotor0</child>
    <axis><xyz>0 0 1</xyz></axis>
    <limit><lower>-1000</lower><upper>1000</upper></limit>
  </joint>
  <link name="rotor0">
    <inertial><mass>0.001</mass></inertial>
    <visual name="rotor0_visual">
      <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
    </visual>
  </link>
  <plugin name="rotor0_plugin" filename="libgazebo_rotor_plugin.so">
    <rotor>
      <jointName>joint0</jointName>
      <topicName>rotor0</topicName>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
    </rotor>
  </plugin>

  <!-- rotor1 -->
  <joint name="joint1" type="revolute">
    <parent>base_link</parent>
    <child>rotor1</child>
    <axis><xyz>0 0 1</xyz></axis>
    <limit><lower>-1000</lower><upper>1000</upper></limit>
  </joint>
  <link name="rotor1">
    <inertial><mass>0.001</mass></inertial>
    <visual name="rotor1_visual">
      <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
    </visual>
  </link>
  <plugin name="rotor1_plugin" filename="libgazebo_rotor_plugin.so">
    <rotor>
      <jointName>joint1</jointName>
      <topicName>rotor1</topicName>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
    </rotor>
  </plugin>

  <!-- rotor2 -->
  <joint name="joint2" type="revolute">
    <parent>base_link</parent>
    <child>rotor2</child>
    <axis><xyz>0 0 1</xyz></axis>
    <limit><lower>-1000</lower><upper>1000</upper></limit>
  </joint>
  <link name="rotor2">
    <inertial><mass>0.001</mass></inertial>
    <visual name="rotor2_visual">
      <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
    </visual>
  </link>
  <plugin name="rotor2_plugin" filename="libgazebo_rotor_plugin.so">
    <rotor>
      <jointName>joint2</jointName>
      <topicName>rotor2</topicName>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
    </rotor>
  </plugin>

  <!-- rotor3 -->
  <joint name="joint3" type="revolute">
    <parent>base_link</parent>
    <child>rotor3</child>
    <axis><xyz>0 0 1</xyz></axis>
    <limit><lower>-1000</lower><upper>1000</upper></limit>
  </joint>
  <link name="rotor3">
    <inertial><mass>0.001</mass></inertial>
    <visual name="rotor3_visual">
      <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
    </visual>
  </link>
  <plugin name="rotor3_plugin" filename="libgazebo_rotor_plugin.so">
    <rotor>
      <jointName>joint3</jointName>
      <topicName>rotor3</topicName>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
    </rotor>
  </plugin>

  <!-- IMU ROS2插件 -->
  <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
    <ros>
      <namespace>/iris</namespace>
      <remapping>imu/out:=imu</remapping>
    </ros>
    <imu>
      <linkName>base_link</linkName>
      <topicName>imu</topicName>
      <noise>
        <angular_velocity>
          <mean>0</mean>
          <stddev>0.001</stddev>
        </angular_velocity>
        <linear_acceleration>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </linear_acceleration>
      </noise>
    </imu>
  </plugin>
</model>
<!-- ROS2 Gazebo桥接插件，保留在model外面，world内部 -->
<plugin name="gazebo_ros" filename="libgazebo_ros.so"/>

</world>
</sdf>

